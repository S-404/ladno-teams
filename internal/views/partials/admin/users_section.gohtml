{{define "partials/admin/users_section"}}
<div class="admin-section">
	{{template "ui/section_header" (sectionHeader "Users" "Invite" "/admin/modals/invite")}}
	{{template "ui/search_bar" .}}
	<table class="admin-table">
		<thead>
			<tr>
				<th>Login</th><th>Admin</th><th>Blocked</th><th>Name</th><th>About</th><th>Created</th><th>Updated</th><th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{{range .Users}}
			{{template "partials/admin/user_row" .}}
			{{end}}
		</tbody>
	</table>
</div>
{{end}}
