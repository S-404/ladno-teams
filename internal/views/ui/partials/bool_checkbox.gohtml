{{define "ui/bool_checkbox"}}
<form hx-post="{{.PostURL}}" hx-trigger="change" hx-swap="none"
	hx-on::after-request="if(!event.detail.successful){const cb=this.querySelector('input[type=checkbox]');if(cb)cb.checked=!cb.checked;}">
	<input type="hidden" name="{{.FieldName}}" value="{{.Value}}">
	<input type="checkbox"{{if .Checked}} checked{{end}} onchange="this.form.querySelector('input[name={{.FieldName}}]').value=this.checked?'true':'false'">
</form>
{{end}}
